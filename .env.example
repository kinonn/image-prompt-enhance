# No env vars required — providers are configured in UI (localStorage + proxy)

# Next.js telemetry: opt out of anonymous usage data collection (see https://nextjs.org/telemetry)
NEXT_TELEMETRY_DISABLED=1

# Optional: set a default base URL override (otherwise https://opencode.ai/zen/go/v1 for Go)
# NEXT_PUBLIC_DEFAULT_GO_URL=https://opencode.ai/zen/go/v1
# NEXT_PUBLIC_DEFAULT_ZEN_URL=https://opencode.ai/zen/v1
# PORT=3000

# SSRF guard: the server refuses to fetch provider base URLs that resolve to
# private/link-local/multicast/reserved addresses (this includes cloud metadata
# at 169.254.169.254). Loopback (localhost) is always allowed for local Ollama /
# LM Studio. To permit additional internal hosts, list them here (comma-separated):
# ALLOWED_PROVIDER_HOSTS=192.168.1.50,my-local-llm.lan

# --- Optional: Google OAuth login -------------------------------------------
# Enables "Sign in with Google" in the sidebar. When signed in, settings and app
# state are preserved in a server-side in-memory store (per user) — they survive
# page refreshes but are lost when the server restarts. Without these vars the
# app runs fully anonymously (login UI is hidden).
#
# 1. Create an OAuth client at https://console.cloud.google.com/apis/credentials
#    (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
# 2. Set AUTH_GOOGLE_ID (Client ID) and AUTH_GOOGLE_SECRET (Client secret)
# 3. Set AUTH_SECRET to a random string, e.g. `openssl rand -base64 32`
#    (required in production; dev falls back to a local-only secret)
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
