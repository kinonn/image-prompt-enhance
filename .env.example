# No env vars required — providers are configured in UI (localStorage + proxy)
# Optional: set a default base URL override (otherwise https://opencode.ai/zen/go/v1 for Go)
# NEXT_PUBLIC_DEFAULT_GO_URL=https://opencode.ai/zen/go/v1
# NEXT_PUBLIC_DEFAULT_ZEN_URL=https://opencode.ai/zen/v1
# PORT=3000

# SSRF guard: the server refuses to fetch provider base URLs that resolve to
# private/link-local/multicast/reserved addresses (this includes cloud metadata
# at 169.254.169.254). Loopback (localhost) is always allowed for local Ollama /
# LM Studio. To permit additional internal hosts, list them here (comma-separated):
# ALLOWED_PROVIDER_HOSTS=192.168.1.50,my-local-llm.lan
